ROBINHOOD_USERNAME=your_email@example.com
ROBINHOOD_PASSWORD=your_password
# Optional: MFA code (if 2FA is enabled, leave blank to be prompted)
ROBINHOOD_MFA_CODE=

# --- Trader settings ---
SYMBOL=SPY
TRADE_AMOUNT_USD=20         # dollars to deploy per trade
ENTRY_MOMENTUM_PCT=0.3      # % SPY must rise from open before buying
TAKE_PROFIT_PCT=0.5         # % gain from entry to sell for profit
STOP_LOSS_PCT=0.3           # % loss from entry to cut position
POLL_SECONDS=30             # price check interval in seconds
